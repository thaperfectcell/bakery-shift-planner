<mxfile host="app.diagrams.net" type="device"><diagram id="flow" name="Схема алгоритма"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Начало" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="95" y="18" width="150" height="44" as="geometry"/></mxCell><mxCell id="c2" value="Ввод: партии batches,&lt;br&gt;печи ovens, смены shifts,&lt;br&gt;max_lead = 7 ч" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="93" width="270" height="84" as="geometry"/></mxCell><mxCell id="c3" value="order = партии, упорядоченные по сроку готовности, затем по убыванию времени выпечки" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="200" width="270" height="80" as="geometry"/></mxCell><mxCell id="c4" value="horizon_start = начало первой смены&lt;br&gt;horizon_end = конец последней смены&lt;br&gt;shift_starts = начала смен" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="310" width="270" height="84" as="geometry"/></mxCell><mxCell id="c5" value="Цикл C&lt;br&gt;для каждой печи oven" style="shape=loopLimit;size=16;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="424" width="270" height="62" as="geometry"/></mxCell><mxCell id="c6" value="Поместить (horizon_start, oven) в кучу free[тип печи]&lt;br&gt;changeover[oven] = время перенастройки&lt;br&gt;last_group[oven] = нет" style="roun