" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="752" y="12" width="36" height="36" as="geometry"/></mxCell><mxCell id="d1" value="(ready, oven) = печь нужного типа, которая освобождается раньше (извлечь из кучи)&lt;br&gt;start = ready" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="300" height="90" as="geometry"/></mxCell><mxCell id="d2" value="Группа изделий&lt;br&gt;на печи сменилась?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="630" y="175" width="280" height="100" as="geometry"/></mxCell><mxCell id="d3" value="start = start + changeover[oven]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="985" y="197" width="230" height="56" as="geometry"/></mxCell><mxCell id="j1" value="" style="shape=ellipse;fillColor=none;strokeColor=none;resizable=0;" vertex="1" parent="1"><mxGeometry x="769.5" y="299.5" width="1" height="1" as="geometry"/></mxCell><mxCell id="d4" value="earliest = срок готовности - max_lead" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="300" height="50" as="geometry"/></mxCell><mxCell id="d5" value="start &lt; earliest?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="630" y="400" width="280" height="90" as="geometry"/></mxCell><mxCell id="d6" value="start = earliest" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="985" y="420" width="230" height="50" as="geometry"/></mxCell><mxCell id="j2" value="" style="shap